# and Stage 3 Layer 2's live feature extractor (extractor/), which needs it for a
# reasonable rate limit (works unauthenticated at 60 requests/hour without it).
# Needs at minimum public_repo / repo:status scope to read workflow runs on public repos.
GITHUB_TOKEN=
