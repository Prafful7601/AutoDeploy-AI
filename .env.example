# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Used by: Stage 1's GitHub Actions API fallback (not needed — TravisTorrent worked),
# Stage 3 Layer 2's live feature extractor (extractor/), and Stage 4's live-mode
# backend endpoint (api/main.py's POST /predict-live) — all need it for a reasonable
# rate limit (works unauthenticated at 60 requests/hour without it, 5,000/hour with).
# Needs at minimum public_repo / repo:status scope to read workflow runs on public repos.
# Read server-side only (python-dotenv, loaded in extractor/github_client.py) — never
# sent to or readable from the web/ frontend.
GITHUB_TOKEN=

# Optional — comma-separated list of origins allowed to call the API (CORS). Defaults
# to the Vite dev server's origins if unset; only needed if you deploy the frontend
# somewhere else.
CORS_ORIGINS=
