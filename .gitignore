# --- Secrets ---
.env
*.token
github_token.txt

# --- Data (never commit raw or processed datasets) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Trained models / large outputs (kept out of git; regenerate via scripts) ---
# EXCEPTION, deliberate: hgb_split_temporal.joblib (~405 KB — genuinely small,
# not a "large output") IS committed, specifically so a fresh Render deploy has
# something to serve without retraining on every deploy. See the README's
# Deployment section for the full reasoning. The held-out-projects sibling
# model stays ignored — it's Stage 2 evaluation output, never served.
outputs/models/*
!outputs/models/.gitkeep
!outputs/models/hgb_split_temporal.joblib
outputs/reports/*.html

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
env/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Web ---
web/node_modules/
web/dist/
